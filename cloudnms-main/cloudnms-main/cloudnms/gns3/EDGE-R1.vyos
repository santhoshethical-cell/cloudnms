# =====================================================================
# EDGE-R1  -  VyOS edge router (tested syntax: VyOS 1.4 "Sagitta" / 1.5 rolling)
# Paste in configuration mode:   configure  ->  (paste)  ->  commit  ->  save
#
# Ports:  eth0 = WAN  -> ISP-SIM eth1 (10.0.0.0/30)
#         eth1 = TRUNK -> SW01 port 0 (802.1Q, VLANs 10/20/99)
#
# Replace <SNMP_AUTH_PASS> and <SNMP_PRIV_PASS> (min 8 chars each) yourself.
# Never commit the real values to GitHub.
# =====================================================================

set system host-name 'EDGE-R1'
set system name-server '1.1.1.1'
set system name-server '8.8.8.8'
set system time-zone 'Asia/Colombo'

# ---------- WAN ----------
set interfaces ethernet eth0 description 'WAN-to-ISP-SIM'
set interfaces ethernet eth0 address '10.0.0.2/30'
set protocols static route 0.0.0.0/0 next-hop '10.0.0.1'

# ---------- Router-on-a-stick ----------
set interfaces ethernet eth1 description 'TRUNK-to-SW01'
set interfaces ethernet eth1 vif 10 description 'VLAN10-STAFF'
set interfaces ethernet eth1 vif 10 address '172.16.10.1/24'
set interfaces ethernet eth1 vif 20 description 'VLAN20-GUEST'
set interfaces ethernet eth1 vif 20 address '172.16.20.1/24'
set interfaces ethernet eth1 vif 99 description 'VLAN99-MGMT'
set interfaces ethernet eth1 vif 99 address '172.16.99.1/28'

# ---------- NAT (all hotel VLANs out of the WAN) ----------
set nat source rule 100 description 'Hotel-LAN-to-Internet'
set nat source rule 100 outbound-interface name 'eth0'
set nat source rule 100 source address '172.16.0.0/16'
set nat source rule 100 translation address 'masquerade'

# ---------- Upload shaping: 100 Mbps egress on WAN ----------
# (Download is shaped on ISP-SIM eth1, because shapers only act on egress.)
set qos policy shaper WAN-UP bandwidth '100mbit'
set qos policy shaper WAN-UP default bandwidth '100%'
set qos policy shaper WAN-UP default queue-type 'fq-codel'
set qos interface eth0 egress 'WAN-UP'

# ---------- SNMPv3 only (authPriv, SHA + AES, read-only) ----------
# No "community" lines => SNMPv1/v2c are disabled (verified by test T02).
set service snmp listen-address 172.16.99.1 port '161'
set service snmp location 'Serendib Stay - Colombo - Server Room'
set service snmp contact 'it-officer@serendibstay.example'
set service snmp v3 engineid '000000000000000000000002'
set service snmp v3 view nms-view oid '1'
set service snmp v3 group nms-ro view 'nms-view'
set service snmp v3 group nms-ro mode 'ro'
set service snmp v3 group nms-ro seclevel 'priv'
set service snmp v3 user nmsuser group 'nms-ro'
set service snmp v3 user nmsuser auth type 'sha'
set service snmp v3 user nmsuser auth plaintext-password '<SNMP_AUTH_PASS>'
set service snmp v3 user nmsuser privacy type 'aes'
set service snmp v3 user nmsuser privacy plaintext-password '<SNMP_PRIV_PASS>'

# ---------- Management: SSH only from the management VLAN ----------
set service ssh listen-address '172.16.99.1'
set service ssh port '22'

# ---------- Version differences ----------
# VyOS 1.3 "Equuleus" uses older syntax. If 'commit' rejects a line, use:
#   set nat source rule 100 outbound-interface 'eth0'
#   set traffic-policy shaper WAN-UP ...   and
#   set interfaces ethernet eth0 traffic-policy out 'WAN-UP'
