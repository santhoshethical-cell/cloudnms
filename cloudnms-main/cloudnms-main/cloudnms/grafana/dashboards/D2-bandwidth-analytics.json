{
  "uid": "cloudnms-bandwidth",
  "title": "CloudNMS - D2 Bandwidth Analytics",
  "description": "Who is using the bandwidth, when, and is the link big enough?",
  "tags": [
    "cloudnms"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "15s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      }
    ]
  },
  "links": [
    {
      "title": "CloudNMS",
      "type": "dashboards",
      "tags": [
        "cloudnms"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "WAN traffic (download up, upload down)",
      "description": "EDGE-R1 eth0, 64-bit SNMP counters every 30 s. Link capacity 100 Mbps.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "rate(ifHCInOctets{device=\"EDGE-R1\",ifName=\"eth0\"}[$__rate_interval]) * 8",
          "legendFormat": "Download",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "rate(ifHCOutOctets{device=\"EDGE-R1\",ifName=\"eth0\"}[$__rate_interval]) * 8",
          "legendFormat": "Upload",
          "refId": "B",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Upload"
            },
            "properties": [
              {
                "id": "custom.transform",
                "value": "negative-Y"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "WAN utilisation",
      "description": "Busiest direction / 100 Mbps. Alert A3 fires above 80 % for 5 min.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max(rate(ifHCInOctets{device=\"EDGE-R1\",ifName=\"eth0\"}[$__rate_interval]), rate(ifHCOutOctets{device=\"EDGE-R1\",ifName=\"eth0\"}[$__rate_interval])) * 8 / 100e6 * 100",
          "legendFormat": "",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "showThresholdMarkers": true
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Traffic per VLAN (to users)",
      "description": "Router sub-interface egress = traffic delivered to each VLAN.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "label_replace(label_replace(label_replace(rate(ifHCOutOctets{device=\"EDGE-R1\",ifName=~\"eth1\\\\.(10|20|99)\"}[$__rate_interval]) * 8, \"vlan\", \"Staff (10)\", \"ifName\", \"eth1\\\\.10\"), \"vlan\", \"Guest (20)\", \"ifName\", \"eth1\\\\.20\"), \"vlan\", \"Mgmt (99)\", \"ifName\", \"eth1\\\\.99\")",
          "legendFormat": "{{vlan}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "95th percentile (24 h)",
      "description": "ISP-style 95th percentile of 30 s samples over the last 24 h.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 16,
        "y": 9,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "quantile_over_time(0.95, (max(rate(ifHCInOctets{device=\"EDGE-R1\",ifName=\"eth0\"}[2m]), rate(ifHCOutOctets{device=\"EDGE-R1\",ifName=\"eth0\"}[2m])) * 8)[1d:30s])",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Data used today (WAN, both directions)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 16,
        "y": 13,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "(increase(ifHCInOctets{device=\"EDGE-R1\",ifName=\"eth0\"}[1d]) + increase(ifHCOutOctets{device=\"EDGE-R1\",ifName=\"eth0\"}[1d]))",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 6,
      "type": "barchart",
      "title": "Daily data volume per VLAN",
      "description": "Use a 7-day or 14-day time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (ifName) (increase(ifHCOutOctets{device=\"EDGE-R1\",ifName=~\"eth1\\\\.(10|20|99)\"}[1d]) + increase(ifHCInOctets{device=\"EDGE-R1\",ifName=~\"eth1\\\\.(10|20|99)\"}[1d]))",
          "legendFormat": "{{ifName}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "interval": "1d"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes"
        },
        "overrides": []
      },
      "options": {
        "xTickLabelRotation": -30,
        "showValue": "auto",
        "stacking": "none",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}